    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E1116" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="72dp" android:height="72dp" />
            <solid android:color="#34D399" />
        </shape>
    </item>
</layer-list>
