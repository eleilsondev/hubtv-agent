<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <!-- fundo gradiente via drawable, fallback cor solida -->
    <View
        android:id="@+id/fundo_gradiente"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- fundo imagem customizada -->
    <ImageView
        android:id="@+id/fundo_imagem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================= TOPBAR =================
             Tres slots de mesma largura. Cada bloco (identidade, atalhos,
             relogio) e movido para o slot escolhido no painel em tempo de
             execucao — ver reposicionarTopbar() na LauncherActivity. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/slot_esquerda"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <!-- bloco identidade: logo + nome -->
                <LinearLayout
                    android:id="@+id/bloco_identidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- maxWidth evita que uma logo muito larga empurre o resto -->
                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:maxWidth="240dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/nome_launcher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HUB TV"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:layout_marginStart="10dp"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4" />
                </LinearLayout>

                <!-- bloco atalhos do sistema (WiFi, Bluetooth, Config) -->
                <LinearLayout
                    android:id="@+id/sistema_atalhos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_centro"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center" />

            <LinearLayout
                android:id="@+id/slot_direita"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <!-- bloco relogio: indicador + hora + vencimento -->
                <LinearLayout
                    android:id="@+id/relogio_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/indicador_status"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/circulo_verde" />

                    <TextView
                        android:id="@+id/relogio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B0FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-light" />

                    <TextView
                        android:id="@+id/data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#70FFFFFF"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ VITRINE: banner + destaques ao lado ============ -->
        <LinearLayout
            android:id="@+id/linha_vitrine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

        <!-- ================= BANNER =================
             Tamanho FIXO em dp, definido no painel (largura_banner x
             altura_banner). Nao usa proporcao: o painel ja recorta a arte
             exatamente nessa medida, entao nada estica nem achata.
             Duas ImageViews sobrepostas fazem o crossfade do carrossel. -->
        <FrameLayout
            android:id="@+id/banner_container"
            android:layout_width="480dp"
            android:layout_height="160dp"
            android:background="@drawable/card_bg"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/banner_imagem_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/banner_imagem_b"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/banner_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/gradiente_inferior">

                <TextView
                    android:id="@+id/banner_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/banner_subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- bolinhas do carrossel -->
            <LinearLayout
                android:id="@+id/banner_pontos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- placeholder quando sem banner -->
            <TextView
                android:id="@+id/banner_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="HUB TV"
                android:textColor="#30FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
        </FrameLayout>

            <!-- ate 2 apps do tipo "destaque", empilhados ao lado do banner.
                 Preenchidos em montarDestaques(). -->
            <LinearLayout
                android:id="@+id/destaques_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- ================= CARROSSEL DE APPS =================
             Fileira horizontal de cards de largura fixa. Com muitos apps a
             lista rola para a direita conforme o foco anda, em vez de
             espremer tudo numa grade. minHeight garante que o nome do app
             nunca some, por maior que fique o banner. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="136dp"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- empurra a barra inferior para baixo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- BARRA INFERIOR: atalhos rapidos de apps -->
        <LinearLayout
            android:id="@+id/atalhos_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- INFO ATIVACAO (sobreposta quando pendente) -->
    <FrameLayout
        android:id="@+id/tela_ativacao"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0101828"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATIVACAO NECESSARIA"
                android:textColor="#FBBF24"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informe o codigo abaixo ao seu revendedor"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/codigo_ativacao_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#22C55E"
                android:textSize="48sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/ativacao_status_texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#60FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- PROGRESSO DA INSTALACAO AUTOMATICA DE APK -->
    <FrameLayout
        android:id="@+id/tela_instalacao"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D0070B14"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="32dp">

            <TextView
                android:id="@+id/instalacao_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <ProgressBar
                android:id="@+id/instalacao_barra"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/instalacao_detalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#90FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- TELA DE BLOQUEIO / LICENCA VENCIDA -->
    <FrameLayout
        android:id="@+id/tela_bloqueio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0070B14"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <!-- logo do revendedor, se houver -->
            <ImageView
                android:id="@+id/bloqueio_logo"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:maxWidth="280dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:layout_marginBottom="28dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bloqueio_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSINATURA VENCIDA"
                android:textColor="#F87171"
                android:textSize="30sp"
                android:letterSpacing="0.04"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bloqueio_mensagem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="640dp"
                android:gravity="center"
                android:text="Fale com seu revendedor para renovar e voltar a assistir."
                android:textColor="#B0FFFFFF"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="14dp" />

            <!-- cartao com o contato de quem vendeu -->
            <LinearLayout
                android:id="@+id/bloqueio_contato_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_marginTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FALE COM SEU REVENDEDOR"
                    android:textColor="#70FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bloqueio_contato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#34D399"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bloqueio_venceu_em"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#60FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
