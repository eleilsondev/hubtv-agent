<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <!-- fundo gradiente via drawable, fallback cor solida -->
    <View
        android:id="@+id/fundo_gradiente"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TOPBAR: logo + nome + atalhos sistema + relogio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nome_launcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUB TV"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <!-- atalhos do sistema (WiFi, Bluetooth, Config) -->
            <LinearLayout
                android:id="@+id/sistema_atalhos"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <!-- status conexao -->
            <View
                android:id="@+id/indicador_status"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circulo_verde" />

            <TextView
                android:id="@+id/relogio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:id="@+id/data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#70FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- CONTEUDO PRINCIPAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- LADO ESQUERDO: categorias + banner -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <!-- categorias tabs -->
                <HorizontalScrollView
                    android:id="@+id/categorias_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/categorias_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- banner / carrossel -->
                <FrameLayout
                    android:id="@+id/banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_bg"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <ImageView
                        android:id="@+id/banner_imagem"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/banner_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/gradiente_inferior">

                        <TextView
                            android:id="@+id/banner_titulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3" />

                        <TextView
                            android:id="@+id/banner_subtitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#B0FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- placeholder quando sem banner -->
                    <TextView
                        android:id="@+id/banner_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="HUB TV"
                        android:textColor="#30FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- LADO DIREITO: grid de apps -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apps_grid"
                android:layout_width="0dp"
                android:layout_weight="0.7"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="4dp" />
        </LinearLayout>

        <!-- BARRA INFERIOR: atalhos rapidos de apps -->
        <LinearLayout
            android:id="@+id/atalhos_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- TELA DE BLOQUEIO -->
    <FrameLayout
        android:id="@+id/tela_bloqueio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPOSITIVO BLOQUEADO"
                android:textColor="#F87171"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entre em contato com seu revendedor"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
