<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo"
    android:padding="24dp">

    <!-- cabecalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitulo"
                android:textColor="@color/suave"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/estado_depuracao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verificando"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/estado_conexao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verificando"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/borda" />

    <!-- passo 1: pareamento -->
    <TextView
        style="@style/Rotulo"
        android:text="@string/passo_parear" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/campo_porta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/porta"
            android:inputType="number"
            android:importantForAutofill="no"
            android:textColor="@color/texto"
            android:textColorHint="@color/fraco" />

        <EditText
            android:id="@+id/campo_codigo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:hint="@string/codigo"
            android:inputType="number"
            android:maxLength="6"
            android:importantForAutofill="no"
            android:textColor="@color/texto"
            android:textColorHint="@color/fraco" />

        <Button
            android:id="@+id/btn_parear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/parear" />
    </LinearLayout>

    <!-- passo 2: acoes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_ligar_depuracao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ligar_depuracao" />

        <Button
            android:id="@+id/btn_conectar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/conectar" />

        <Button
            android:id="@+id/btn_testar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/testar" />

        <Button
            android:id="@+id/btn_fixar_porta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/fixar_porta" />

        <ProgressBar
            android:id="@+id/progresso"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- registro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp">

        <TextView
            style="@style/Rotulo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/registro" />

        <Button
            android:id="@+id/btn_limpar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/limpar"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/rolagem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@color/painel"
        android:padding="14dp">

        <TextView
            android:id="@+id/registro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/suave"
            android:textSize="12sp"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
